[Unit]
Description=Omarchy Session Memory — capture daemon
PartOf=graphical-session.target
After=osm-restore.service

[Service]
Type=simple
ExecStart=%h/.local/share/osm/bin/osm daemon
ExecStop=%h/.local/share/osm/bin/osm snapshot --reason shutdown
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
